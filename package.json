{
  "name": "bureau",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Bureau - autonomous FX desk on Celo: trades Mento stablecoins and sells market data per-call via x402, settled in USDC onchain",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spagero763/bureau.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "npm run build --workspace celo-agent-kit && tsc",
    "build:kit": "npm run build --workspace celo-agent-kit",
    "register": "tsx scripts/register-8004.ts",
    "demo": "tsx scripts/demo-client.ts",
    "test:game": "tsx scripts/test-game.ts",
    "x402:key": "tsx scripts/get-x402-key.ts",
    "x402:topup": "node scripts/topup-credits.mjs"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@mento-protocol/mento-sdk": "^3.2.8",
    "@selfxyz/agent-sdk": "^0.2.1",
    "@x402/evm": "^2.18.0",
    "@x402/express": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "celo-agent-kit": "*",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.26"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
